{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/favicon.svg"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
